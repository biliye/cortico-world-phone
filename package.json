{
  "name": "cortico-world-phone",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: 电话——接起真来电、听到对方、说出她的话、挂断(耳朵=本机语音识别,嗓子=TTS,话机=另一个进程里的桥)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-phone.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-phone#readme",
  "keywords": [
    "cortico-world",
    "cortico",
    "qq",
    "voice-call"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "电话"
  },
  "files": [
    "src",
    "cloud",
    "docs",
    "probes",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "ttscheck": "tsx scripts/tts-check.ts",
    "bridgeprobe": "tsx scripts/bridge-probe.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
