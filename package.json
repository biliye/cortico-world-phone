{
  "name": "cortico-world-phone",
  "version": "0.1.1",
  "type": "module",
  "description": "Cortico World:电话——接得起真来电、听得见对方、说得出她的话、挂断。★ 非即插即用:装之前先把它交给一个 coding agent,从 AGENTS.md 读起 —— 这条线要另起一个跑 QQ 的协议端,每个决定都是环境相关的(见 docs/route-*)。耳朵=本机语音识别,嗓子=TTS。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biliye/cortico-world-phone.git"
  },
  "homepage": "https://github.com/biliye/cortico-world-phone#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "qq",
    "voice-call"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "电话"
  },
  "files": [
    "src",
    "cloud",
    "docs",
    "probes",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "ttscheck": "tsx scripts/tts-check.ts",
    "bridgeprobe": "tsx scripts/bridge-probe.ts",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
