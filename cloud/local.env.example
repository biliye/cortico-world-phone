# 拷成 local.env 再填。**这一份不要进 git**(.gitignore 已经挡住 local.env)。
# 它是"这套部署自己的值",不是密码:密码/令牌从来不写文件里,只走部署的 .env。

# 跑 QQ 的那个号。同一个号只能有一处在线:在别处登录会把这里的顶掉。
PHONE_ACCOUNT=10001

# 协议端那台的地址(手工跑 cloud/tunnel.sh 时用;World 自己那条隧道读部署配置的 ssh.host)。
# PHONE_HOST=<那台的地址>

# 手工跑隧道用的私钥路径(对应部署里 worlds.phone.ssh.keyFile)。
# PHONE_KEY=<私钥路径>

# 小内存机器上"可以让位"的其它容器名,空格分隔(docker stop 只停它们,回滚脚本会起回来)。
# FREE_MEMORY_CONTAINERS=ln-web ln-backend ln-mysql
